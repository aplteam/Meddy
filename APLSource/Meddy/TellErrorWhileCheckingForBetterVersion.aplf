 TellErrorWhileCheckingForBetterVersion←{
     errMsg←⍵
     msg←⊂'Unable to check GitHub for a better version - an error has ocurred',(0<≢errMsg)⊃'.:'
     msg,←(0<≢errMsg)/1↑(⎕UCS 13 10)A.Split errMsg
     msg,←'' 'Please check your Internet connection.'
     #.CursorObj←0
     ShowMeddyMsg msg
 }
