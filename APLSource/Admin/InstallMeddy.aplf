 {r}←InstallMeddy dummy;setupExe;installDir32;q;filename;rc;processInfo;result;msg;distributionFolder;C;F
⍝ Asks the user whethern she wants to innstall Meddy. if there is an installer EXE
 r←0
 C←##.TestCases.CommTools
 F←##.Meddy.FilesAndDirs
 distributionFolder←##.CiderConfig.HOME,'/',##.CiderConfig.CIDER.distributionFolder
 setupExe←F.ListFiles2 distributionFolder,'/*.exe'
 'Check "distributionFolder" - there must be exactly one file SetUp*.exe in it'Assert 1=≢setupExe
 setupExe←⊃setupExe
 :If 1 C.YesOrNo'Would you like to execute "',setupExe,'" ?'
     installDir32←(2 ⎕NQ #'GetEnvironment' 'ProgramFiles(x86)'),'\Kai Jaeger\Meddy\'
     :If ⎕NEXISTS installDir32
         q←'' 'It appears that the 32-bit version of Meddy is installed. Uninstall?'
         :If 1 C.YesOrNo q
             filename←⊃⊃F.Dir installDir32,'/unins???.exe'
             :If 0<≢filename
                 (rc processInfo result msg)←##.Meddy.Execute.Application filename
                 {⍵:.}rc≠0
                 :If F.IsFile filename
                     ⎕←'The 32-bit version of Meddy is still installed, therefore the 64-bit version cannot be installed!'
                     :Return
                 :EndIf
             :Else
                 ⎕←'The 32-bit version of Meddy is still installed, therefore the 64-bit version cannot be installed!'
                 :Return
             :EndIf
         :EndIf
     :EndIf
     (rc processInfo result msg)←##.Meddy.Execute.Application setupExe
     'Something went wrong'Assert 0=rc
 :EndIf
